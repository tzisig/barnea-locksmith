---
import Logo from './Logo.astro';
import { site, contact, services, areas, nav, legalNav, legal, analytics, telUrl, whatsappUrl } from '../config/site.config';
const year = new Date().getFullYear();
---
<footer class="site-footer night">
  <div class="wrap cols">
    <div class="brand">
      <Logo />
      <p class="muted">{site.tagline}. {contact.responsePromise}.</p>
      <p><a href={telUrl} class="phone ltr">{contact.phone}</a></p>
      <p><a href={whatsappUrl()} target="_blank" rel="noopener">וואטסאפ (נפתח בחלון חדש)</a></p>
    </div>
    <div>
      <h2 class="col-title">שירותים</h2>
      <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.navTitle}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="col-title">אזורי שירות</h2>
      <ul>{areas.map((a) => <li><a href={`/areas/${a.slug}/`}>מנעולן {a.nameIn}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="col-title">מידע</h2>
      <ul>
        {nav.filter((n) => !['/services/', '/areas/'].includes(n.href)).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/emergency/">נעולים בחוץ</a></li>
        {legalNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap bottom">
    <p>&copy; {year} {legal.businessName}. עוסק מורשה <span class="ltr">{legal.businessId}</span>.</p>
    {analytics.ga4 && <p><button type="button" class="linklike" data-consent-open>הגדרות עוגיות</button></p>}
  </div>
  {site.isDemo && <p class="wrap demo">{site.demoNote}</p>}
</footer>

<style>
  .site-footer { padding-block: var(--s-8) var(--s-5); border-top: 4px solid var(--c-alert); font-size: 1rem; }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: var(--s-7); padding-bottom: var(--s-7); }
  .brand { display: grid; gap: var(--s-3); align-content: start; }
  .phone { font-size: 1.5rem; font-weight: 800; color: var(--c-on-night) !important; text-decoration: none; }
  .col-title { font-size: 1.0625rem; font-stretch: 87.5%; margin-bottom: var(--s-3); color: var(--c-on-night-muted); }
  ul { list-style: none; display: grid; gap: 2px; }
  ul a { display: inline-flex; min-height: 36px; align-items: center; color: var(--c-on-night) !important; text-decoration: none; }
  ul a:hover { text-decoration: underline; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--c-night-line); color: var(--c-on-night-muted); font-size: 0.9375rem; }
  .bottom p + p { margin: 0; }
  .linklike { background: none; border: 0; padding: 0; min-height: 44px; font: inherit; color: var(--c-signal-on-night); text-decoration: underline; cursor: pointer; }
  .demo { margin-top: var(--s-3); font-size: 0.875rem; color: var(--c-on-night-muted); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
</style>
