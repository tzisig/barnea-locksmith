---
// Areas with arrival windows drawn as bars on one time scale: the distance is the information.
import { areas } from '../config/site.config';
const scaleMax = Math.max(...areas.map((a) => a.eta.max)) + 5;
const pct = (n: number) => `${(n / scaleMax) * 100}%`;
---
<div class="eta">
  <p class="scale-note">זמן הגעה מתלפיות, בדקות</p>
  <ul>
    {areas.map((a, i) => (
      <li class="reveal" style={`--i:${i}`}>
        <a href={`/areas/${a.slug}/`}>
          <span class="name">{a.name}</span>
          <span class="track" aria-hidden="true"><span class="bar" style={`inset-inline-start:${pct(a.eta.min)}; width:calc(${pct(a.eta.max)} - ${pct(a.eta.min)})`}></span></span>
          <span class="val">{a.eta.min}-{a.eta.max} דק'</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .scale-note { font-size: 0.875rem; color: var(--c-on-night-muted); margin-bottom: var(--s-3); }
  ul { list-style: none; display: grid; }
  a { display: grid; grid-template-columns: 7.5rem 1fr 5.5rem; align-items: center; gap: var(--s-4); min-height: 56px; border-bottom: 1px solid var(--c-night-line); text-decoration: none; color: var(--c-on-night) !important; }
  .name { font-weight: 800; font-stretch: 87.5%; font-size: 1.125rem; }
  .track { position: relative; height: 10px; border-radius: 99px; background: var(--c-night-2); }
  .bar { position: absolute; top: 0; bottom: 0; border-radius: 99px; background: linear-gradient(to left, var(--c-open), var(--c-signal-on-night)); }
  .val { font-size: 0.9375rem; color: var(--c-on-night-muted); text-align: end; }
  a:hover .name { text-decoration: underline; }
  @media (max-width: 520px) { a { grid-template-columns: 6rem 1fr 4.75rem; gap: var(--s-3); } }
</style>
