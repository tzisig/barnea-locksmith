---
import { site } from '../config/site.config';
---
<a class="logo" href="/">
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="8" fill="var(--c-alert)" />
    <circle cx="20" cy="16" r="6" fill="var(--c-night)" />
    <path d="M17 19h6l2.2 12h-10.4z" fill="var(--c-night)" />
  </svg>
  <span class="words">
    <span class="name">{site.shortName}</span>
    <span class="trade">{site.trade}</span>
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; min-height: 44px; }
  .mark { width: 40px; height: 40px; flex: none; }
  .words { display: grid; line-height: 1; }
  .name { font-size: 1.625rem; font-weight: 900; font-stretch: 62.5%; letter-spacing: 0.01em; }
  .trade { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.12em; opacity: 0.8; margin-top: 3px; }
</style>
