---
// Night band at the top of inner pages. Optional photo sits on the end side.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  title: string;
  lead?: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, lead, crumbs, image, imageAlt = '' } = Astro.props;
---
<section class:list={['page-hero', 'night', { 'has-img': image }]}>
  <div class="wrap inner">
    <div class="text">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image && (
      <div class="media">
        <Picture src={image} alt={imageAlt} widths={[480, 800, 1100]} sizes="(min-width: 900px) 40vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero { padding-block: var(--s-6) var(--s-8); }
  .inner { display: grid; gap: var(--s-7); align-items: center; }
  .has-img .inner { grid-template-columns: 1.15fr 0.85fr; }
  .lead { margin-top: var(--s-4); }
  .media { aspect-ratio: 4 / 3; }
  @media (max-width: 900px) { .has-img .inner { grid-template-columns: 1fr; } .media { aspect-ratio: 16 / 9; } }
</style>
