---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs, services, site } from '../config/site.config';
import { breadcrumbSchema, faqSchema, home } from '../lib/schema';

const crumbs = [home, { label: 'שאלות נפוצות', href: '/faq/' }];
---
<BaseLayout title="שאלות נפוצות על מנעולנים" description={`תשובות לשאלות נפוצות: כמה עולה מנעולן, איך יודעים שהוא אמין, פתיחה בלי נזק, תשלום ושבת. ${site.name}, ירושלים והסביבה.`} schema={[breadcrumbSchema(crumbs), faqSchema(faqs)]}>
  <PageHero title="שאלות נפוצות" lead="לא מצאתם תשובה? התקשרו או שלחו וואטסאפ." crumbs={crumbs} />
  <section class="section">
    <div class="narrow">
      <h2 class="mb">כללי</h2>
      <FaqList items={faqs} />
      {services.map((s) => (
        <>
          <h2 class="mb top"><a href={`/services/${s.slug}/`}>{s.title}</a></h2>
          <FaqList items={s.faqs} />
        </>
      ))}
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .mb { margin-bottom: var(--s-4); font-size: var(--t-h3); }
  .top { margin-top: var(--s-8); }
  .mb a { color: var(--c-ink); }
</style>
